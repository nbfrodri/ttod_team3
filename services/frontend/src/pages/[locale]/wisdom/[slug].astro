---
import Page from '../../../layouts/Page.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import EmptyState from '../../../components/EmptyState.astro';
import FavoriteButton from '../../../components/favorites/FavoriteButton';
import { isLocale, labels, loadWisdom } from '../../../content/wisdom';
import { SESSION_COOKIE_NAME, getSessionUser } from '../../../lib/auth.server';
import type { FavoriteEntry } from '../../../types/domain';
import '../../../styles/tokens.css';
const locale = Astro.params.locale;
if (!isLocale(locale)) return new Response(null, { status: 404 });
const { entries, failed } = await loadWisdom(locale);
const quote = failed ? undefined : entries.find((entry) => entry.id === Astro.params.slug);
const copy = labels[locale];

// El botón de favoritos solo se monta con sesión: una petición anónima recibe la página de siempre.
const user = quote ? await getSessionUser(Astro.request) : null;
let alreadySaved = false;
if (user && quote) {
  const backend = import.meta.env.BACKEND_URL ?? 'http://backend:8000';
  const sessionCookie = `${SESSION_COOKIE_NAME}=${Astro.cookies.get(SESSION_COOKIE_NAME)?.value ?? ''}`;
  try {
    const response = await fetch(`${backend}/api/v1/favorites`, { headers: { accept: 'application/json', cookie: sessionCookie } });
    if (response.ok) alreadySaved = ((await response.json()) as FavoriteEntry[]).some((favorite) => favorite.quoteId === quote.id);
  } catch {
    // Si la biblioteca no responde el botón sale como "guardar"; guardar dos veces no duplica.
  }
}
const crumbs = quote
  ? [
      { label: copy.wisdom, href: `/${locale}/wisdom/` },
      { label: quote.section, href: `/${locale}/wisdom/sections/${quote.section}/` },
      { label: quote.id },
    ]
  : [{ label: copy.wisdom, href: `/${locale}/wisdom/` }, { label: copy.notFound }];
---
<Page lang={locale} title={quote ? `${quote.id} · ${copy.wisdom}` : copy.notFound}>
  <main class="ttod-shell ttod-prose">
    <nav class="ttod-nav"><a href={`/${locale}/wisdom/`}>← {copy.back}</a><a href={`/${locale}/docs/`}>{copy.docs}</a></nav>
    <Breadcrumbs locale={locale} items={crumbs} />
    {failed ? <EmptyState variant="error" title={copy.errorTitle} message={copy.errorMessage} /> : !quote ? <EmptyState title={copy.notFound} message={copy.notFoundMessage} action={{ label: copy.back, href: `/${locale}/wisdom/` }} /> : <>
      <article class="ttod-card"><blockquote>{quote.text}</blockquote><p><strong>{copy.teaches}:</strong> {quote.teaches}</p><p class="ttod-meta">{quote.id} · {quote.section} · {quote.level} · {quote.origin} · {quote.lang}</p><div class="ttod-clusters">{quote.tags.map((tag) => <a class="ttod-pill" href={`/${locale}/wisdom/tags/${tag}/`}>#{tag}</a>)}</div>{user && <FavoriteButton client:load quoteId={quote.id} initiallySaved={alreadySaved} />}</article>
      <footer class="ttod-meta">{quote.rights.holder ?? 'Rubén Vega Balbás'} · {quote.rights.license} · <a href="https://creativecommons.org/licenses/by-nc-sa/4.0/">CC BY-NC-SA 4.0</a></footer>
    </>}
  </main>
</Page>
