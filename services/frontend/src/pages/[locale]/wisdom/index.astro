---
import Page from '../../../layouts/Page.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import EmptyState from '../../../components/EmptyState.astro';
import { frequencies, isLocale, labels, loadWisdom, quoteSlug } from '../../../content/wisdom';
import '../../../styles/tokens.css';
const locale = Astro.params.locale;
if (!isLocale(locale)) return new Response(null, { status: 404 });
const { entries, failed } = await loadWisdom(locale);
const copy = labels[locale];
---
<Page lang={locale} title={copy.wisdom}>
  <main class="ttod-shell">
    <nav class="ttod-nav"><a href={`/${locale}/`}>← {locale === 'es' ? 'Inicio' : 'Home'}</a><a href={`/${locale}/docs/`}>{copy.docs}</a><a href={`/${locale}/wisdom/propose/`}>{copy.propose}</a></nav>
    <Breadcrumbs locale={locale} items={[{ label: copy.wisdom }]} />
    <h1>{copy.wisdom}</h1>
    {failed ? <EmptyState variant="error" title={copy.errorTitle} message={copy.errorMessage} /> : entries.length === 0 ? <EmptyState title={copy.emptyTitle} message={copy.empty} /> : <>
      <section><h2>{copy.sections}</h2><div class="ttod-clusters">{frequencies(entries, 'section').map(([value, count]) => <a class="ttod-pill" href={`/${locale}/wisdom/sections/${value}/`}>{value} ({count})</a>)}</div></section>
      <section><h2>{copy.levels}</h2><div class="ttod-clusters">{frequencies(entries, 'level').map(([value, count]) => <a class="ttod-pill" href={`/${locale}/wisdom/levels/${value}/`}>{value} ({count})</a>)}</div></section>
      <section><h2>{copy.tags}</h2><div class="ttod-clusters">{frequencies(entries, 'tags').map(([value, count]) => <a class="ttod-pill" href={`/${locale}/wisdom/tags/${value}/`}>{value} ({count})</a>)}</div></section>
      <section><h2>{copy.all}</h2><div class="ttod-grid">{entries.map((entry) => <article class="ttod-card"><blockquote>{entry.text}</blockquote><a href={`/${locale}/wisdom/${quoteSlug(entry)}/`}>{entry.id}</a><p class="ttod-meta">{entry.section} · {entry.level}</p><footer class="ttod-meta">{entry.rights.holder ?? 'Rubén Vega Balbás'} · {entry.rights.license}</footer></article>)}</div></section>
    </>}
  </main>
</Page>
