---
import Page from '../../layouts/Page.astro';
import FavoriteButton from '../../components/favorites/FavoriteButton';
import { SESSION_COOKIE_NAME, requireUser } from '../../lib/auth.server';
import { isLocale } from '../../content/wisdom';
import type { FavoriteEntry, WisdomEntry } from '../../types/domain';

export const prerender = false;

const locale = Astro.params.locale;
if (!isLocale(locale)) return new Response(null, { status: 404 });

const authenticatedUser = await requireUser(Astro.request);
if (authenticatedUser instanceof Response) return authenticatedUser;

const backend = import.meta.env.BACKEND_URL ?? 'http://backend:8000';
// Al backend solo se reenvía la cookie de sesión, no el resto de cabeceras del navegador.
const sessionCookie = `${SESSION_COOKIE_NAME}=${Astro.cookies.get(SESSION_COOKIE_NAME)?.value ?? ''}`;

const [favoritesResponse, wisdomResponse] = await Promise.all([
  fetch(`${backend}/api/v1/favorites`, { headers: { accept: 'application/json', cookie: sessionCookie } }),
  fetch(`${backend}/api/v1/wisdom/sample`, { headers: { accept: 'application/json' } }),
]);
if (!favoritesResponse.ok || !wisdomResponse.ok) {
  throw new Error('Unable to load the personal library');
}
const favorites = (await favoritesResponse.json()) as FavoriteEntry[];
const wisdom = (await wisdomResponse.json()) as WisdomEntry[];
const quotes = favorites
  .map((favorite) => ({ favorite, quote: wisdom.find((entry) => entry.id === favorite.quoteId) }))
  .filter((entry): entry is { favorite: FavoriteEntry; quote: WisdomEntry } => Boolean(entry.quote));
const copy = locale === 'es'
  ? { title: 'Mi biblioteca', empty: 'Todavía no has guardado citas.', saved: 'Guardada' }
  : { title: 'My library', empty: 'You have not saved any quotes yet.', saved: 'Saved' };
---
<Page lang={locale} title={copy.title}>
  <style>
    button { transition: opacity 160ms ease; }
    @media (prefers-reduced-motion: reduce) {
      button { transition: none; }
    }
  </style>
  <main>
    <h1>{copy.title}</h1>
    {quotes.length === 0 ? <p>{copy.empty}</p> : <section aria-label={copy.title}>
      {quotes.map(({ favorite, quote }) => <article>
        <blockquote>{quote.text}</blockquote>
        <p class="meta">{quote.id} · {quote.section} · {copy.saved} {favorite.savedAt}</p>
        <FavoriteButton client:load quoteId={quote.id} />
      </article>)}
    </section>}
  </main>
</Page>
