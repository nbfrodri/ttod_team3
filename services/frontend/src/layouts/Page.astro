---
interface Props { lang: 'en' | 'es'; title: string }
const { lang, title } = Astro.props;
import '../styles/tokens.css';

const nav = {
  en: {
    home: 'Home', wisdom: 'Wisdom', library: 'Library', graph: 'Graph', oracle: 'Oracle', docs: 'Docs',
    skip: 'Skip to content', switchTo: 'Español',
    footer: 'A pedagogical wisdom database — instructor reference build.',
  },
  es: {
    home: 'Inicio', wisdom: 'Sabiduría', library: 'Biblioteca', graph: 'Grafo', oracle: 'Oráculo', docs: 'Docs',
    skip: 'Saltar al contenido', switchTo: 'English',
    footer: 'Una base de datos de sabiduría pedagógica — build de referencia del profesorado.',
  },
}[lang];

const otherLocale = lang === 'en' ? 'es' : 'en';
const switchPath = '/' + otherLocale + Astro.url.pathname.replace(/^\/(en|es)/, '');

const links: Array<{ href: string; label: string }> = [
  { href: `/${lang}/`, label: nav.home },
  { href: `/${lang}/wisdom/`, label: nav.wisdom },
  { href: `/${lang}/library`, label: nav.library },
  { href: `/${lang}/graph`, label: nav.graph },
  { href: `/${lang}/oracle`, label: nav.oracle },
  { href: `/${lang}/docs/`, label: nav.docs },
];
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#fbf8f1" />

    <link rel="manifest" href="/site.webmanifest" />
    <link rel="icon" href="/visual-system/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="/visual-system/tokens.css" />
    <link rel="stylesheet" href="/visual-system/backgrounds.css" />

    <title>{title}</title>
    <style>
      :root { color-scheme: light; font-family: var(--ttod-font-body); }
      body { margin: 0; color: var(--ttod-color-ink); background-color: var(--ttod-color-paper); line-height: 1.6; }
      .ttod-skip-link {
        position: absolute; left: -999px; top: 0; z-index: 30;
        padding: 0.5rem 1rem; background: var(--ttod-color-accent, #b0522d); color: #fff;
      }
      .ttod-skip-link:focus { left: 0.5rem; top: 0.5rem; }
      .ttod-site-header {
        display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between;
        gap: 1rem; padding: 1rem 1.5rem; font-family: ui-sans-serif, system-ui, sans-serif;
        border-bottom: 1px solid var(--ttod-color-line, #8f8068);
      }
      .ttod-site-header a { color: inherit; }
      .ttod-brand { font-weight: 700; text-decoration: none; }
      .ttod-site-nav { display: flex; flex-wrap: wrap; gap: 1rem; }
      .ttod-site-nav a[aria-current="page"] { text-decoration: underline; text-underline-offset: 3px; }
      .ttod-lang-switch { font-size: 0.9rem; }
      main { max-width: 48rem; margin: 0 auto; padding: 2.5rem 1.5rem; }
      nav { display: flex; gap: 1rem; font-family: ui-sans-serif, system-ui, sans-serif; }
      article { border-inline-start: .25rem solid var(--ttod-color-accent); margin-block: 2rem; padding-inline: 1.5rem; }
      .meta { font-family: ui-sans-serif, system-ui, sans-serif; font-size: .9rem; opacity: .8; }
      .ttod-site-footer {
        margin-top: 3rem; padding: 1.5rem; font-family: ui-sans-serif, system-ui, sans-serif;
        font-size: 0.85rem; opacity: 0.8; border-top: 1px solid var(--ttod-color-line, #8f8068);
        max-width: 48rem; margin-inline: auto;
      }

      #ttod-network-boundary {
        padding: 0.5rem 1.5rem;
        font-family: ui-sans-serif, system-ui, sans-serif;
      }
    </style>
  </head>
  <body class="ttod-bg-river">
    <a class="ttod-skip-link" href="#ttod-main">{nav.skip}</a>
    <header class="ttod-site-header">
      <a class="ttod-brand" href={`/${lang}/`}>道 TTOD</a>
      <nav class="ttod-site-nav" aria-label={lang === 'es' ? 'Navegación principal' : 'Main navigation'}>
        {links.map((link) => (
          <a href={link.href} aria-current={Astro.url.pathname === link.href ? 'page' : undefined}>{link.label}</a>
        ))}
      </nav>
      <a class="ttod-lang-switch" href={switchPath} hreflang={otherLocale}>{nav.switchTo}</a>
    </header>
    <p
      id="ttod-network-boundary"
      role="status"
      aria-live="polite"
      aria-atomic="true"
      data-state="unknown"
      data-online-label={lang === 'es' ? 'En línea' : 'Online'}
      data-offline-label={lang === 'es' ? 'Sin conexión' : 'Offline'}
    >
      {lang === 'es' ? 'Comprobando conexión…' : 'Checking connection…'}
    </p>
    <div id="ttod-main">
      <slot />
    </div>
    <footer class="ttod-site-footer">
      <p>{nav.footer} © Rubén Vega Balbás · CC BY-NC-SA 4.0 (content) · MIT (code)</p>
    </footer>
    <script>
      const boundary = document.getElementById('ttod-network-boundary');

      if (boundary) {
        const updateNetworkState = () => {
          const online = navigator.onLine;

          boundary.dataset.state = online ? 'online' : 'offline';
          boundary.textContent = online
            ? boundary.dataset.onlineLabel ?? 'Online'
            : boundary.dataset.offlineLabel ?? 'Offline';
        };

        updateNetworkState();

        window.addEventListener('online', updateNetworkState);
        window.addEventListener('offline', updateNetworkState);
      }

      if ('serviceWorker' in navigator) {
        navigator.serviceWorker.register('/sw.js').catch((error) => {
          console.error('Service worker registration failed:', error);
        });
      }
    </script>
  </body>
</html>
