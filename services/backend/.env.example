# Configuración local; el login queda deshabilitado hasta configurar el hash bcrypt del admin.
OLLAMA_MODE=host
OLLAMA_MODEL=qwen3.8:27b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_BASE_URL=http://host.containers.internal:11434
MCP_SERVER_URL=http://mcp:3001
ORACLE_RETRIEVAL_THRESHOLD=0.575
ORACLE_RETRIEVAL_TOP_K=5
TTOD_PATH=/workspace/ttod.yml
TTOD_SCHEMA_DIR=/workspace/schema
TTOD_PROPOSAL_DIR=/workspace/services/backend/data/proposals
# Si se omite, el backend genera una clave temporal; define una clave estable para conservar sesiones.
# Genera una clave segura: python -c "import secrets; print(secrets.token_urlsafe(32))"
TTOD_SESSION_SECRET=
TTOD_SESSION_TTL_SECONDS=3600
# Secreto del token de la API pública (PAT). Debe ser distinto del de la sesión web.
TTOD_PAT_SECRET=
TTOD_PAT_TTL_SECONDS=3600
TTOD_ADMIN_EMAIL=admin@ttod.local
TTOD_ADMIN_PASSWORD_HASH=
# Genera el hash sin dejar la contraseña en el historial del shell:
# python -c "from getpass import getpass; from passlib.context import CryptContext; print(CryptContext(schemes=['bcrypt']).hash(getpass()))"
